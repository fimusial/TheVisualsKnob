{
  "vstgui-ui-description": {
    "version": "1",
    "bitmaps": {},
    "fonts": {},
    "colors": {},
    "control-tags": {},
    "custom": {
      "VST3Editor": {
        "Show Editor Button": "false"
      }
    },
    "templates": {
      "view": {
        "attributes": {
          "autosize": "left right top bottom",
          "background-color": "#ff0000ff",
          "background-color-draw-style": "filled",
          "class": "CViewContainer",
          "mouse-enabled": "true",
          "opacity": "1",
          "origin": "0, 0",
          "size": "400, 400",
          "minSize": "200, 200",
          "maxSize": "3840, 2160",
          "transparent": "false",
          "wants-focus": "false"
        },
        "children": {
          "WaveformVisualizer": {
            "attributes": {
              "class": "WaveformVisualizer",
              "origin": "0, 0",
              "size": "400, 400",
              "autosize": "left right top bottom"
            }
          }
        }
      }
    }
  }
}
