{
  "vstgui-ui-description": {
    "version": "1",
    "bitmaps": {},
    "fonts": {},
    "colors": {},
    "control-tags": {
      "Visualizer": "256"
    },
    "custom": {
      "VST3Editor": {
        "Show Editor Button": "false"
      }
    },
    "templates": {
      "view": {
        "attributes": {
          "autosize": "left right top bottom",
          "background-color": "#ff0000ff",
          "background-color-draw-style": "filled",
          "class": "CViewContainer",
          "mouse-enabled": "true",
          "opacity": "1",
          "origin": "0, 0",
          "size": "400, 400",
          "minSize": "200, 200",
          "maxSize": "3840, 2160",
          "transparent": "false",
          "wants-focus": "false"
        },
        "children": {
          "Container": {
            "attributes": {
              "class": "UIViewSwitchContainer",
              "origin": "0, 0",
              "size": "400, 400",
              "autosize": "left right top bottom",
              "template-names": "WaveformTemplate,SpectrogramTemplate",
              "template-switch-control": "Visualizer",
              "animation-time": "0"
            }
          },
          "Switcher": {
            "attributes": {
              "class": "Switcher",
              "origin": "0, 0",
              "size": "400, 400",
              "autosize": "left right top bottom",
              "stepCount": "2",
              "parameterId": "256"
            }
          }
        }
      },
      "WaveformTemplate": {
        "attributes": {
          "class": "CViewContainer",
          "origin": "0, 0",
          "size": "400, 400",
          "autosize": "left right top bottom",
          "transparent": "false"
        },
        "children": {
          "WaveformVisualizer": {
            "attributes": {
              "class": "WaveformVisualizer",
              "origin": "0, 0",
              "size": "400, 400",
              "autosize": "left right top bottom"
            }
          }
        }
      },
      "SpectrogramTemplate": {
        "attributes": {
          "class": "CViewContainer",
          "origin": "0, 0",
          "size": "400, 400",
          "autosize": "left right top bottom",
          "transparent": "false"
        },
        "children": {
          "SpectrogramVisualizer": {
            "attributes": {
              "class": "SpectrogramVisualizer",
              "origin": "0, 0",
              "size": "400, 400",
              "autosize": "left right top bottom"
            }
          }
        }
      }
    }
  }
}
